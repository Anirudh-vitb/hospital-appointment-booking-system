# Copy to .env for local development. Never commit the real .env file.
PORT=5000
NODE_ENV=development
# Local MongoDB, or your Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/carepoint?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/carepoint
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Exact origin(s) of the React app, comma-separated, no trailing slash
FRONTEND_URL=http://localhost:5173
HOSPITAL_TIMEZONE=Asia/Kolkata
# Used by `npm run seed` and `npm run create-admin` to create the administrator
ADMIN_EMAIL=admin@carepoint.example
ADMIN_PASSWORD=
# Password given to the fictional demo patient and doctor accounts by the seed
SEED_DEMO_PASSWORD=CarePoint@2026
# Only for a cross-site deployment without the frontend proxy (see README)
CROSS_SITE_COOKIES=false
# Separate database used by automated tests (its name must contain "test")
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/carepoint_test
