<style>
  body { margin: 0; font: 15px/1.55 system-ui, sans-serif; background: #fbfaf7; color: #14213d; }
  main { max-width: 760px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 1.6rem; margin: 4px 0 8px; }
  h2 { font-size: 1.1rem; margin: 32px 0 8px; }
  .eyebrow { margin: 0; color: #0f766e; font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; }
  .note { color: #4a5568; margin: 0 0 12px; }
  table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e5e1d8; }
  th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid #efebe3; }
  th { width: 40%; font-weight: 500; color: #4a5568; }
  .pill { padding: 2px 8px; border-radius: 4px; font-size: .85rem; }
  .ok { background: #dcf3ee; color: #0f5f58; } .warn { background: #fdecd3; color: #8a4b08; }
  form { display: grid; gap: 12px; background: #fff; border: 1px solid #e5e1d8; padding: 16px; }
  label { display: grid; gap: 4px; font-weight: 500; }
  select, input, button { font: inherit; padding: 8px 10px; border: 1px solid #c9c3b6; border-radius: 6px; }
  button { background: #0f766e; color: #fff; border-color: #0f766e; cursor: pointer; width: max-content; }
  button:focus-visible, select:focus-visible, input:focus-visible { outline: 3px solid #f2b84b; outline-offset: 2px; }
  .error { color: #9b1c1c; background: #fdecec; padding: 8px 12px; }
  .slots { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .slots li { padding: 4px 8px; border: 1px solid #c9c3b6; border-radius: 4px; background: #fff; }
  .slots li.available { border-color: #0f766e; color: #0f5f58; }
  .slots li:not(.available) { color: #8a8f99; text-decoration: line-through; }
  .slots small { font-size: .7rem; }
  a { color: #0f766e; }
</style>
